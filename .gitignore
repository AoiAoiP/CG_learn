# ============================================================
#  CG_Learn — 忽略规则
#  原则：只上传学习源码 / 笔记 / 资源；构建产物与编译器中间件不入库。
#        third_party/ 与教程 PDF 按约定保留。
# ============================================================

# ---------- 构建目录（任意层级）----------
build/
build-*/
[Bb]in/
[Oo]bj/
out/

# ---------- 编译器 / 链接器产物 ----------
*.o
*.obj
# 例外：backpack 模型是资源，不是编译产物
!OpenGL/resources/**/*.obj
*.exe
*.pdb
*.ilk
*.exp
*.dll
*.a
*.so
*.app
# OpenGL 各课目录下编译出的无扩展名可执行文件
opengl_app

# ---------- IDE / 编辑器 ----------
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln

# ---------- 系统垃圾 ----------
Thumbs.db
desktop.ini
*Zone.Identifier*

# ---------- 嵌套仓库备份（OpenGL 原 gitee 仓库的 .git，仅本地保留）----------
.git-backups/
